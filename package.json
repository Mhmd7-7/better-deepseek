{
  "name": "better-deepseek-chrome",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node build.js --watch",
    "build": "node build.js",
    "build:chrome": "node build.js",
    "test": "npm run test:unit && npm run test:ui",
    "test:unit": "vitest run",
    "test:ui": "playwright test --config=playwright.config.cjs",
    "test:extension": "playwright test --config=playwright.extension.config.cjs",
    "check-locales": "node scripts/check-locales.js",
    "package:extension": "python3 scripts/package.py"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "jsdom": "^26.1.0",
    "svelte": "^5.28.2",
    "vite": "^6.3.1",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "docx": "^9.6.1",
    "fflate": "^0.8.2",
    "html2canvas": "^1.4.1",
    "ignore": "^7.0.5",
    "marked": "^18.0.3",
    "pptxgenjs": "^4.0.1",
    "turndown": "^7.2.4",
    "vega": "^6.4.0",
    "vega-embed": "^7.2.0",
    "vega-interpreter": "^2.3.2",
    "vega-lite": "^6.4.3",
    "xlsx": "^0.18.5",
    "youtube-transcript": "^1.3.0"
  }
}
